# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

[*]
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
charset = utf-8
max_line_length = 132

[*.py]
indent_style = space
indent_size = 4

## LEGACY - use 2 space indent
[*.{js,mjs}]
indent_style = space
indent_size = 2

[*.{json,jsonl}]
indent_style = space
indent_size = 2

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[Dockerfile]
indent_style = space
indent_size = 4

[*.sh]
indent_style = tab

[Makefile]
indent_style = tab
